<Window x:Class="DeskPilot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskPilot"
        Width="760"
        Height="620"
        MinWidth="640"
        MinHeight="520">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="26" FontWeight="SemiBold" Text="DeskPilot — управление звуком" />

            <Border Grid.Row="1" Margin="0,20,0,0" Padding="16" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="Текущее устройство:" />
                    <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding Audio.DefaultDeviceName}" />
                    <Button Grid.Column="2" Padding="14,5" Command="{Binding Audio.RefreshFromUiCommand}" Content="Обновить" />

                    <TextBlock Grid.Row="1" Margin="0,16,0,0" VerticalAlignment="Center" Text="Доступные устройства:" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,12,0,0"
                              ItemsSource="{Binding Audio.OutputDevices}"
                              SelectedItem="{Binding Audio.SelectedDevice}"
                              DisplayMemberPath="FriendlyName" />

                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,12,0,0" Orientation="Horizontal">
                        <Button Padding="12,5" Command="{Binding Audio.SaveSpeakersCommand}" Content="Сохранить как колонки" />
                        <Button Margin="8,0,0,0" Padding="12,5" Command="{Binding Audio.SaveHeadphonesCommand}" Content="Сохранить как наушники" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,16,0,0" Padding="16" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Колонки:" />
                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                               Text="{Binding Audio.SpeakersDevice.FriendlyName, TargetNullValue=Не выбраны}" />
                    <Button Grid.Column="2" Padding="14,5" Command="{Binding Audio.UseSpeakersCommand}"
                            Content="Использовать" IsEnabled="{Binding Audio.CanUseSpeakers}" />

                    <TextBlock Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Наушники:" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,12,0,0">
                        <TextBlock Text="{Binding Audio.HeadphonesDevice.FriendlyName, TargetNullValue=Не выбраны}" />
                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="Gray"
                                   Text="Bluetooth-модель станет доступна после подключения в Windows." />
                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" Padding="14,5"
                            Command="{Binding Audio.UseHeadphonesCommand}"
                            Content="Использовать" IsEnabled="{Binding Audio.CanUseHeadphones}" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Margin="0,16,0,0" Padding="16" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Громкость:" />
                    <Slider Grid.Column="1" Margin="8,0" Minimum="0" Maximum="100" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Audio.VolumePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Width="42" VerticalAlignment="Center" TextAlignment="Right"
                               Text="{Binding Audio.VolumePercentage, StringFormat={}{0}%}" />

                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,14,0,0" Orientation="Horizontal">
                        <Button Width="44" Padding="8,5" Command="{Binding Audio.DecreaseVolumeCommand}" Content="−" />
                        <Button Margin="8,0,0,0" Width="44" Padding="8,5" Command="{Binding Audio.IncreaseVolumeCommand}" Content="+" />
                        <Button Margin="8,0,0,0" Padding="12,5" Command="{Binding Audio.ApplyVolumeCommand}" Content="Применить" />
                        <Button Margin="8,0,0,0" Padding="12,5" Command="{Binding Audio.ToggleMuteCommand}" Content="Вкл./выкл. звук" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Audio.MuteStatus}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" Margin="0,16,0,0" Padding="12" Background="#F3F6FA" CornerRadius="6">
                <TextBlock TextWrapping="Wrap" Text="{Binding Audio.StatusMessage}" />
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
