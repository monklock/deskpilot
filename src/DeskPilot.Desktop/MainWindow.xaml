<Window x:Class="DeskPilot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskPilot"
        Width="880"
        Height="860"
        MinWidth="720"
        MinHeight="620">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="DeskPilot — локальное управление" />

            <TextBlock Margin="0,20,0,8" FontSize="20" FontWeight="SemiBold" Text="Ручное управление звуком" />
            <Border Padding="16" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="Текущее устройство:" />
                    <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding Audio.DefaultDeviceName}" />
                    <Button Grid.Column="2" Padding="14,5" Command="{Binding Audio.RefreshFromUiCommand}" Content="Обновить" />

                    <TextBlock Grid.Row="1" Margin="0,16,0,0" VerticalAlignment="Center" Text="Доступные устройства:" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,12,0,0"
                              ItemsSource="{Binding Audio.OutputDevices}"
                              SelectedItem="{Binding Audio.SelectedDevice}"
                              DisplayMemberPath="FriendlyName" />

                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,12,0,0" Orientation="Horizontal">
                        <Button Padding="12,5" Command="{Binding Audio.SaveSpeakersCommand}" Content="Сохранить как колонки" />
                        <Button Margin="8,0,0,0" Padding="12,5" Command="{Binding Audio.SaveHeadphonesCommand}" Content="Сохранить как наушники" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,12,0,0" Padding="16" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Колонки:" />
                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                               Text="{Binding Audio.SpeakersDevice.FriendlyName, TargetNullValue=Не выбраны}" />
                    <Button Grid.Column="2" Padding="14,5" Command="{Binding Audio.UseSpeakersCommand}"
                            Content="Использовать" IsEnabled="{Binding Audio.CanUseSpeakers}" />

                    <TextBlock Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Наушники:" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,12,0,0">
                        <TextBlock Text="{Binding Audio.HeadphonesDevice.FriendlyName, TargetNullValue=Не выбраны}" />
                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="Gray"
                                   Text="Bluetooth-модель станет доступна после подключения в Windows." />
                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" Padding="14,5"
                            Command="{Binding Audio.UseHeadphonesCommand}"
                            Content="Использовать" IsEnabled="{Binding Audio.CanUseHeadphones}" />
                </Grid>
            </Border>

            <Border Margin="0,12,0,0" Padding="16" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Громкость:" />
                    <Slider Grid.Column="1" Margin="8,0" Minimum="0" Maximum="100" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Audio.VolumePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Width="42" VerticalAlignment="Center" TextAlignment="Right"
                               Text="{Binding Audio.VolumePercentage, StringFormat={}{0}%}" />

                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,14,0,0" Orientation="Horizontal">
                        <Button Width="44" Padding="8,5" Command="{Binding Audio.DecreaseVolumeCommand}" Content="−" />
                        <Button Margin="8,0,0,0" Width="44" Padding="8,5" Command="{Binding Audio.IncreaseVolumeCommand}" Content="+" />
                        <Button Margin="8,0,0,0" Padding="12,5" Command="{Binding Audio.ApplyVolumeCommand}" Content="Применить" />
                        <Button Margin="8,0,0,0" Padding="12,5" Command="{Binding Audio.ToggleMuteCommand}" Content="Вкл./выкл. звук" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Audio.MuteStatus}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,12,0,0" Padding="12" Background="#F3F6FA" CornerRadius="6">
                <TextBlock TextWrapping="Wrap" Text="{Binding Audio.StatusMessage}" />
            </Border>

            <TextBlock Margin="0,24,0,8" FontSize="20" FontWeight="SemiBold" Text="Голосовое управление" />
            <Border Padding="16" BorderBrush="#8AA9C7" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Состояние:" />
                        <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="{Binding Voice.CurrentStateText}" />
                        <Button Grid.Column="2" MinWidth="100" Padding="14,5"
                                Command="{Binding Voice.ToggleVoiceCommand}"
                                Content="{Binding Voice.ToggleVoiceButtonText}" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Микрофон:" />
                        <ComboBox Grid.Column="1" Margin="8,0" MinWidth="280"
                                  ItemsSource="{Binding Voice.Microphones}"
                                  SelectedItem="{Binding Voice.SelectedMicrophone}"
                                  DisplayMemberPath="FriendlyName" />
                        <Button Grid.Column="2" Padding="12,5" Command="{Binding Voice.RefreshMicrophonesFromUiCommand}" Content="Обновить" />
                        <Button Grid.Column="3" Margin="8,0,0,0" Padding="12,5" Command="{Binding Voice.UseSelectedMicrophoneCommand}" Content="Использовать" />
                    </Grid>
                    <TextBlock Margin="168,5,0,0" FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                               Text="Bluetooth-микрофон восстанавливается только по сохранённому endpoint ID. Подключите то же устройство и нажмите «Обновить»." />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Чувствительность:" />
                        <Slider Grid.Column="1" Margin="8,0" Minimum="0.65" Maximum="0.90" TickFrequency="0.01"
                                IsSnapToTickEnabled="True"
                                Value="{Binding Voice.Sensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                   Text="{Binding Voice.Sensitivity, StringFormat={}{0:F2}}" />
                        <Button Grid.Column="3" Margin="8,0,0,0" Padding="12,5" Command="{Binding Voice.SaveSensitivityCommand}" Content="Сохранить" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Фраза активации:" />
                        <TextBlock Grid.Column="1" Margin="8,0" FontWeight="SemiBold" Text="{Binding Voice.WakePhrase}" />
                        <TextBlock Grid.Row="1" Text="Последняя команда:" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,0" TextWrapping="Wrap" Text="{Binding Voice.LastRecognizedText}" />
                        <TextBlock Grid.Row="2" Margin="0,6,0,0" Text="Результат:" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="8,6,0,0" TextWrapping="Wrap" Text="{Binding Voice.LastCommandOutcome}" />
                    </Grid>

                    <Border Margin="0,16,0,0" Padding="12" Background="#F7F9FB" CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Активные локальные модели" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding Voice.ActiveWakeModelVersion, StringFormat=Vosk: {0}}" />
                            <TextBlock Margin="0,3,0,0" Text="{Binding Voice.ActiveCommandModelVersion, StringFormat=Whisper: {0}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,16,0,6" FontWeight="SemiBold" Text="Менеджер моделей" />
                    <ComboBox ItemsSource="{Binding Voice.Models.Models}"
                              SelectedItem="{Binding Voice.Models.SelectedModel}"
                              DisplayMemberPath="DisplayName" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Padding="12,5" Command="{Binding Voice.Models.CheckForUpdatesCommand}" Content="Проверить обновления" />
                        <Button Margin="8,0,0,0" Padding="12,5" Command="{Binding Voice.Models.DownloadOrUpdateCommand}" Content="Скачать/обновить" />
                        <Button Margin="8,0,0,0" Padding="12,5" Command="{Binding Voice.Models.CancelDownloadCommand}" Content="Отмена" />
                        <Button Margin="8,0,0,0" Padding="12,5" Command="{Binding Voice.Models.UseModelCommand}" Content="Использовать" />
                        <Button Margin="8,0,0,0" Padding="12,5" Command="{Binding Voice.Models.RestoreBuiltInCommand}" Content="Восстановить встроенную" />
                    </WrapPanel>
                    <ProgressBar Margin="0,10,0,0" Height="8" Minimum="0" Maximum="100" Value="{Binding Voice.Models.ProgressPercentage}" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Voice.Models.StatusMessage}" />

                    <Border Margin="0,14,0,0" Padding="12" Background="#EEF5FB" CornerRadius="6">
                        <TextBlock TextWrapping="Wrap" Text="{Binding Voice.StatusMessage}" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
